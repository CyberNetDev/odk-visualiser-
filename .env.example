# Tous ces réglages sont FACULTATIFS : les utilisateurs se connectent à leur plateforme
# (ODK Central, IASO, CommCare, DHIS2 ou mSupply) directement depuis l'application, avec leur propre compte.
# Aucun mot de passe ni aucune clé API n'est stocké ici.

# ---- Plateformes proposées sur l'écran de connexion, dans cet ordre (odk, iaso, commcare, dhis2, msupply)
PLATFORMS=odk,iaso,commcare,dhis2,msupply

# ---- ODK Central
# Adresse proposée par défaut sur l'écran de connexion
ODK_DEFAULT_URL=
# true = imposer ODK_DEFAULT_URL (les utilisateurs ne peuvent pas choisir un autre serveur)
ODK_LOCK_URL=false

# ---- IASO (Bluesquare)
# Adresse proposée par défaut (sinon https://iaso.bluesquare.org est suggérée)
IASO_DEFAULT_URL=
IASO_LOCK_URL=false
# Soumissions par page demandées à /api/instances/
IASO_PAGE_SIZE=500

# ---- CommCare HQ (Dimagi)
# Adresse proposée par défaut (sinon https://www.commcarehq.org est suggérée)
COMMCARE_DEFAULT_URL=
COMMCARE_LOCK_URL=false
# Formulaires par page demandés à l'API (1000 au maximum)
COMMCARE_PAGE_SIZE=1000

# ---- DHIS2
DHIS2_DEFAULT_URL=
DHIS2_LOCK_URL=false
# Lignes par page (événements ; les inscriptions sont demandées par pages 5 fois plus petites)
DHIS2_PAGE_SIZE=1000
# Données agrégées sans dates choisies : nombre de mois chargés
DHIS2_DEFAULT_MONTHS=12

# ---- mSupply (Open mSupply ou serveur web de mSupply Desktop)
MSUPPLY_DEFAULT_URL=
MSUPPLY_LOCK_URL=false
# Lignes par page GraphQL (Open mSupply)
MSUPPLY_PAGE_SIZE=500

# ---- Commun
# Liste blanche de serveurs autorisés, toutes plateformes, séparés par des virgules (vide = tous)
ALLOWED_SERVERS=
# Proposer le bouton "données de démonstration"
ALLOW_DEMO=true
# Durée maximale d'une session IASO, CommCare, DHIS2 ou Open mSupply (heures).
# ODK Central fixe lui-même la durée ; mSupply Desktop : 2 heures.
SESSION_HOURS=12

PORT=3000
# Docker : port publié sur la machine (127.0.0.1:3000 derrière un reverse proxy)
HOST_PORT=3000
# ---- Cache des données (requêtes lourdes)
# Données de moins de N minutes : servies directement. Au-delà : affichées tout de suite
# puis mises à jour en arrière-plan (seulement les soumissions nouvelles ou modifiées).
CACHE_MINUTES=5
# Au-delà de N heures sans mise à jour, on attend la mise à jour avant d'afficher
CACHE_MAX_STALE_HOURS=24
# Rechargement complet au moins toutes les N heures (même si les mises à jour incrémentales marchent)
CACHE_FULL_REFRESH_HOURS=12
# true = garder le cache sur disque (data/cache, fichiers compressés, survit aux redémarrages)
# false = mémoire seulement (rien n'est écrit sur le disque)
CACHE_PERSIST=true
# Taille maximale du cache en mémoire et sur disque (en Mo, données compressées)
CACHE_MEMORY_MB=256
CACHE_DISK_MB=2048
# Dossier du cache (par défaut data/cache)
CACHE_DIR=
# Lignes par page OData (ODK Central)
PAGE_SIZE=1000
# Cookie "Secure" : auto (si HTTPS détecté), true ou false
COOKIE_SECURE=auto
