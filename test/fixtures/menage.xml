      <instance id="antigene">
        <root>
          <item>
            <itextId>antigene-0</itextId>
            <name>bcg</name>
          </item>
          <item>
            <itextId>antigene-1</itextId>
            <name>penta</name>
          </item>
          <item>
            <itextId>antigene-2</itextId>
            <name>rr</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/debut" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/>
      <bind nodeset="/data/fin" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/>
      <bind nodeset="/data/date_visite" type="date"/>
      <bind nodeset="/data/menage/chef" type="string"/>
      <bind nodeset="/data/menage/taille" type="int"/>
      <bind nodeset="/data/menage/milieu" type="string"/>
      <bind nodeset="/data/menage/biens" type="string"/>
      <bind nodeset="/data/menage/revenu" type="decimal"/>
      <bind nodeset="/data/menage/gps" type="geopoint"/>
      <bind nodeset="/data/membres/prenom" type="string"/>
      <bind nodeset="/data/membres/age" type="int"/>
      <bind nodeset="/data/membres/sexe" type="string"/>
      <bind nodeset="/data/membres/vaccins/antigene" type="string"/>
      <bind nodeset="/data/nb_enfants" type="string" calculate="count( /data/membres/prenom )"/>
      <bind nodeset="/data/merci" readonly="true()" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/date_visite">
      <label ref="jr:itext('/data/date_visite:label')"/>
    </input>
    <group appearance="field-list" ref="/data/menage">
      <label ref="jr:itext('/data/menage:label')"/>
      <input ref="/data/menage/chef">
        <label ref="jr:itext('/data/menage/chef:label')"/>
      </input>
      <input ref="/data/menage/taille">
        <label ref="jr:itext('/data/menage/taille:label')"/>
      </input>
      <select1 ref="/data/menage/milieu">
        <label ref="jr:itext('/data/menage/milieu:label')"/>
        <itemset nodeset="instance('milieu')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select ref="/data/menage/biens">
        <label ref="jr:itext('/data/menage/biens:label')"/>
        <itemset nodeset="instance('biens')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/menage/revenu">
        <label ref="jr:itext('/data/menage/revenu:label')"/>
      </input>
      <input ref="/data/menage/gps">
        <label ref="jr:itext('/data/menage/gps:label')"/>
      </input>
    </group>
    <group ref="/data/membres">
      <label ref="jr:itext('/data/membres:label')"/>
      <repeat nodeset="/data/membres">
        <input ref="/data/membres/prenom">
          <label ref="jr:itext('/data/membres/prenom:label')"/>
        </input>
        <input ref="/data/membres/age">
          <label ref="jr:itext('/data/membres/age:label')"/>
        </input>
        <select1 ref="/data/membres/sexe">
          <label ref="jr:itext('/data/membres/sexe:label')"/>
          <itemset nodeset="instance('sexe')/root/item">
            <value ref="name"/>
            <label ref="jr:itext(itextId)"/>
          </itemset>
        </select1>
        <group ref="/data/membres/vaccins">
          <label ref="jr:itext('/data/membres/vaccins:label')"/>
          <repeat nodeset="/data/membres/vaccins">
            <select1 ref="/data/membres/vaccins/antigene">
              <label ref="jr:itext('/data/membres/vaccins/antigene:label')"/>
              <itemset nodeset="instance('antigene')/root/item">
                <value ref="name"/>
                <label ref="jr:itext(itextId)"/>
              </itemset>
            </select1>
          </repeat>
        </group>
      </repeat>
    </group>
    <input ref="/data/merci">
      <label ref="jr:itext('/data/merci:label')"/>
    </input>
  </h:body>
</h:html>
