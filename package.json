{
  "name": "odk-visualizer",
  "version": "2.0.0",
  "description": "DHIS2 Data Visualizer-style charts, pivot tables and maps for ODK Central, IASO (Bluesquare) and CommCare HQ",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/connectors.test.js",
    "sim:iaso": "node test/sim-iaso.js",
    "sim:commcare": "node test/sim-commcare.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
